# =============================================
# AgentFlow — Environment Configuration
# =============================================

# ---- LLM Providers ----
# At least one is required. OpenAI is the default.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ---- Telegram Bot (optional) ----
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ---- Database ----
# SQLite is used by default (no setup needed).
# Change to PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/agentflow
DATABASE_URL=sqlite+aiosqlite:///./data/agentflow.db

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- Storage ----
CHROMA_PERSIST_DIR=./data/chroma
CHECKPOINTER_DB_PATH=./data/checkpointer.db

# ---- Security ----
# Set to a secret string to require X-API-Key header on all API requests.
# Leave empty to disable authentication (default for local development).
API_KEY=

# ---- Approval Timeout ----
# Executions stuck in awaiting_approval for longer than this (minutes) are auto-failed.
# Set to 0 to disable timeout.
APPROVAL_TIMEOUT_MINUTES=60

# ---- Rate Limiting ----
# Max workflow trigger requests per minute per workflow ID.
TRIGGER_RATE_LIMIT=30

# ---- Debug ----
DEBUG=false
